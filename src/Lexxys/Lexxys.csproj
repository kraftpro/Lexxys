<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0;net462</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>

    <VersionPrefix>3.0.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <Description>Common Infrastructure Library</Description>
    <Copyright>Copyright © 2001-2016</Copyright>
    <Authors>Kraft Pro Utilities</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Dump0\**" />
    <EmbeddedResource Remove="Dump0\**" />
    <None Remove="Dump0\**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ConfigFile" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
  </ItemGroup>

  <PropertyGroup>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Lexxys.xml</DocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/kraftpro/Lexxys</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/kraftpro/Lexxys</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Configuration\ConfigurationSource\DatabaseConfigurationSource.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.*" />
    <PackageReference Include="System.Collections.Immutable" Version="10.0.*" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.*" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.*" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
		<InternalsVisibleTo Include="$(AssemblyName).Configuration" />
		<InternalsVisibleTo Include="$(AssemblyName).Logging" />
    <InternalsVisibleTo Include="$(AssemblyName).Legacy" />
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    <InternalsVisibleTo Include="$(AssemblyName).Xml" />
    <InternalsVisibleTo Include="$(AssemblyName).Test.Console" />
    <InternalsVisibleTo Include="$(AssemblyName).Validation" />
    <InternalsVisibleTo Include="$(AssemblyName).Arguments" />
    <InternalsVisibleTo Include="$(AssemblyName).DataContext" />
    <InternalsVisibleTo Include="TestPizza" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lexxys.Results\Lexxys.Results.csproj" />
    <ProjectReference Include="..\Lexxys.Tokenizer\Lexxys.Tokenizer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="readme.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
